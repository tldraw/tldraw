{
	"name": "@tldraw/headless",
	"description": "tldraw infinite canvas SDK (headless editor for Node.js).",
	"version": "5.3.2",
	"/* PRIVATE */": "Experimental — not published to npm yet. Remove `private` to include it in releases.",
	"private": true,
	"author": {
		"name": "tldraw GB Ltd.",
		"email": "hello@tldraw.com"
	},
	"homepage": "https://tldraw.dev",
	"license": "SEE LICENSE IN LICENSE.md",
	"tldraw_product": {
		"stableId": "tldraw:headless",
		"name": "Headless",
		"type": "feature",
		"parent": "tldraw:sdk-core",
		"premium": false
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/tldraw/tldraw"
	},
	"bugs": {
		"url": "https://github.com/tldraw/tldraw/issues"
	},
	"keywords": [
		"tldraw",
		"sdk",
		"headless",
		"node",
		"server",
		"agent",
		"whiteboard",
		"canvas",
		"infinite"
	],
	"/* NOTE */": "These `main` and `types` fields are rewritten by the build script. They are not the actual values we publish",
	"main": "./src/index.ts",
	"types": "./.tsbuild/index.d.ts",
	"type": "module",
	"/* GOTCHA */": "files will include ./dist and index.d.ts by default, add any others you want to include in here",
	"files": [],
	"scripts": {
		"typecheck-examples": "yarn run -T tsc -p tsconfig.examples.json",
		"test-ci": "yarn run -T vitest run --passWithNoTests",
		"test": "yarn run -T vitest --passWithNoTests",
		"test-coverage": "yarn run -T vitest run --coverage --passWithNoTests",
		"lint": "yarn run -T tsx ../../internal/scripts/lint.ts",
		"build": "yarn run -T tsx ../../internal/scripts/build-package.ts",
		"build-api": "yarn run -T tsx ../../internal/scripts/build-api.ts",
		"prepack": "yarn run -T tsx ../../internal/scripts/prepack.ts",
		"postpack": "../../internal/scripts/postpack.sh",
		"pack-tarball": "yarn pack"
	},
	"devDependencies": {
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@types/ws": "^8.18.1",
		"react": "^19.2.1",
		"react-dom": "^19.2.1",
		"typescript": "^7.0.2",
		"vitest": "^4.1.7",
		"ws": "^8.18.0"
	},
	"dependencies": {
		"@tldraw/editor": "workspace:*",
		"@tldraw/state": "workspace:*",
		"@tldraw/sync-core": "workspace:*",
		"@tldraw/tlschema": "workspace:*",
		"@tldraw/utils": "workspace:*",
		"linkedom": "^0.18.13",
		"tldraw": "workspace:*"
	},
	"peerDependencies": {
		"react": "^18.2.0 || ^19.2.1",
		"react-dom": "^18.2.0 || ^19.2.1"
	},
	"engines": {
		"node": ">=22.12.0"
	}
}
