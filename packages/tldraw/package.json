{
	"name": "tldraw",
	"description": "A tiny little drawing editor.",
	"version": "5.4.2",
	"author": {
		"name": "tldraw Inc.",
		"email": "hello@tldraw.com"
	},
	"homepage": "https://tldraw.dev",
	"license": "SEE LICENSE IN LICENSE.md",
	"tldraw_product": {
		"stableId": "tldraw:sdk-core",
		"name": "SDK",
		"type": "product",
		"premium": false
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/tldraw/tldraw"
	},
	"bugs": {
		"url": "https://github.com/tldraw/tldraw/issues"
	},
	"keywords": [
		"tldraw",
		"sdk",
		"drawing",
		"app",
		"development",
		"whiteboard",
		"canvas",
		"infinite"
	],
	"/* NOTE */": "These `main` and `types` fields are rewritten by the build script. They are not the actual values we publish",
	"main": "./src/index.ts",
	"types": "./.tsbuild/index.d.ts",
	"exports": {
		".": "./src/index.ts",
		"./src/test/test-jsx": "./src/test/test-jsx.tsx",
		"./*.css": "./*.css"
	},
	"type": "module",
	"scripts": {
		"test-ci": "pnpm exec vitest run --passWithNoTests",
		"test": "pnpm exec vitest --passWithNoTests",
		"test-coverage": "pnpm exec vitest run --coverage --passWithNoTests",
		"predev": "node ./scripts/copy-css-files.mjs",
		"dev": "chokidar '../{editor/editor,tldraw/src/lib/ui}.css' -c 'node ./scripts/copy-css-files.mjs'",
		"prebuild": "node ./scripts/copy-css-files.mjs",
		"build": "pnpm exec tsx ../../internal/scripts/build-package.ts",
		"build-api": "pnpm exec tsx ../../internal/scripts/build-api.ts",
		"prepack": "pnpm exec tsx ../../internal/scripts/prepack.ts",
		"postpack": "../../internal/scripts/postpack.sh",
		"pack-tarball": "pnpm pack",
		"lint": "pnpm exec tsx ../../internal/scripts/lint.ts"
	},
	"files": [
		"tldraw.css"
	],
	"dependencies": {
		"@tiptap/core": "^3.12.1",
		"@tiptap/extension-code": "^3.12.1",
		"@tiptap/extension-highlight": "^3.12.1",
		"@tiptap/extension-list": "^3.12.1",
		"@tiptap/pm": "^3.12.1",
		"@tiptap/react": "^3.12.1",
		"@tiptap/starter-kit": "^3.12.1",
		"@tldraw/driver": "workspace:*",
		"@tldraw/editor": "workspace:*",
		"@tldraw/state": "workspace:*",
		"@tldraw/store": "workspace:*",
		"@tldraw/tlschema": "workspace:*",
		"classnames": "^2.5.1",
		"idb": "^7.1.1",
		"lz-string": "^1.5.0",
		"radix-ui": "^1.4.2"
	},
	"peerDependencies": {
		"react": "^18.2.0 || ^19.2.1",
		"react-dom": "^18.2.0 || ^19.2.1"
	},
	"devDependencies": {
		"@peculiar/webcrypto": "^1.5.0",
		"@testing-library/dom": "^10.0.0",
		"@testing-library/react": "^16.0.0",
		"@types/classnames": "^2.3.4",
		"@types/lz-string": "^1.5.0",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"chokidar-cli": "^3.0.0",
		"fake-indexeddb": "^4.0.2",
		"jest-diff": "^30.4.1",
		"lazyrepo": "0.0.0-alpha.27",
		"react": "^19.2.1",
		"react-dom": "^19.2.1",
		"resize-observer-polyfill": "^1.5.1",
		"vitest": "^5.0.0"
	},
	"engines": {
		"node": ">=22.12.0"
	}
}
