	"version": "5.3.2",
	"author": {
		"name": "tldraw Inc.",
		"email": "hello@tldraw.com"
	},
	"homepage": "https://tldraw.dev",
	"license": "SEE LICENSE IN LICENSE.md",
	"tldraw_product": {
		"stableId": "tldraw:commenting",
		"name": "Commenting",
		"type": "feature",
		"parent": "tldraw:collaboration",
		"premium": true,
		"licenseFlag": "FEAT_COMMENTING"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/tldraw/tldraw"
	},
	"bugs": {
