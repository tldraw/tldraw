{
	"$schema": "https://json.schemastore.org/tsconfig",
	"display": "Default",
	"compilerOptions": {
		"composite": true,
		"declaration": true,
		"declarationMap": true,
		"emitDeclarationOnly": true,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"incremental": true,
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"lib": ["DOM", "DOM.Iterable", "ESNext"],
		"module": "esnext",
		"target": "esnext",
		"moduleResolution": "bundler",
		// With the global virtual store (.pnpmfile.cjs), a library that imports @types/react without
		// declaring it can't find it, and its types silently become any. Map @types only: bundlers
		// read `paths` too, and mapping runtime packages sends them past `exports`.
		"paths": { "*": ["${configDir}/node_modules/@types/*"] },
		"noFallthroughCasesInSwitch": true,
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"noUncheckedSideEffectImports": false,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"skipLibCheck": true,
		"strict": true,
		"strictFunctionTypes": true,
		"strictNullChecks": true,
		"useDefineForClassFields": true,
		"noImplicitOverride": true,
		"experimentalDecorators": true,
		"types": ["node", "vitest/globals"]
	},
	"exclude": ["node_modules"]
}
