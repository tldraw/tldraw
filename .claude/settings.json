{
	"spinnerVerbs": {
		"mode": "replace",
		"verbs": [
			"panning",
			"zooming",
			"scrolling",
			"drawing",
			"selecting",
			"nudging",
			"resizing",
			"rotating",
			"flipping",
			"stretching",
			"aligning",
			"distributing",
			"stacking",
			"packing",
			"grouping",
			"cropping",
			"styling",
			"embedding",
			"scribbling",
			"brushing",
			"pointing",
			"snapping to grid"
		]
	},
	"permissions": {
		"allow": [
			"WebSearch",
			"Bash(gh pr:*)",
			"Bash(pnpm install)",
			"Bash(pnpm test:*)",
			"Bash(pnpm lint:*)",
			"Bash(pnpm typecheck)",
			"Bash(git add:*)"
		]
	},
	"hooks": {
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "cd \"$(git rev-parse --show-toplevel)\" && git diff --name-only --diff-filter=ACMR | grep -E '\\.(ts|tsx|js|jsx|json|md)$' | xargs -r pnpm exec prettier --write || true"
					}
				]
			}
		]
	},
	"enabledPlugins": {}
}
