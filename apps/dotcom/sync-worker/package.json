{
	"name": "@tldraw/dotcom-worker",
	"description": "tldraw infinite canvas SDK (merge server).",
	"version": "0.0.0",
	"private": true,
	"author": {
		"name": "tldraw GB Ltd.",
		"email": "hello@tldraw.com"
	},
	"main": "./src/worker.ts",
	"type": "module",
	"/* GOTCHA */": "files will include ./dist and index.d.ts by default, add any others you want to include in here",
	"files": [],
	"scripts": {
		"dev": "pnpm exec tsx ../../../internal/scripts/workers/dev.ts --persist-to .wrangler/state-dev --var ASSET_UPLOAD_ORIGIN:http://localhost:8788 --var USER_CONTENT_URL:http://localhost:8789",
		"test-ci": "pnpm exec vitest run --passWithNoTests",
		"test": "pnpm exec vitest --passWithNoTests",
		"clean": "rm -rf .wrangler/state .wrangler/state-*",
		"test-coverage": "pnpm exec vitest run --coverage --passWithNoTests",
		"check-bundle-size": "pnpm exec tsx ../../../internal/scripts/check-worker-bundle.ts --entry src/worker.ts --size-limit-bytes 1550000",
		"reset-db": "./reset-db.sh",
		"lint": "pnpm exec tsx ../../../internal/scripts/lint.ts",
		"build-types": "tsc --build"
	},
	"dependencies": {
		"@clerk/backend": "^3.17.1",
		"@rocicorp/zero": "1.9.0",
		"@supabase/supabase-js": "^2.48.1",
		"@tldraw/dotcom-shared": "workspace:*",
		"@tldraw/store": "workspace:*",
		"@tldraw/sync-collaboration": "workspace:*",
		"@tldraw/sync-core": "workspace:*",
		"@tldraw/tlschema": "workspace:*",
		"@tldraw/utils": "workspace:*",
		"@tldraw/worker-shared": "workspace:*",
		"itty-router": "^5.0.18",
		"kysely": "^0.28.12",
		"p-queue": "^9.3.0",
		"pg": "^8.16.3"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260302.0",
		"@types/pg": "^8.16.0",
		"esbuild": "^0.28.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.0",
		"wrangler": "^4.75.0"
	}
}
