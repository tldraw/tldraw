{
	"installCommand": "pnpm install --filter examples.tldraw.com... --filter @tldraw/monorepo... --filter config...",
	"buildCommand": "cd ../../packages/tldraw && pnpm prebuild && cd ../../packages/commenting && pnpm prebuild && cd ../../apps/examples && pnpm build",
	"outputDirectory": "dist",
	"headers": [
		{
			"source": "/assets/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public,max-age=31536000,immutable"
				}
			]
		}
	],
	"rewrites": [
		{
			"source": "/(.*)",
			"destination": "/"
		}
	]
}
