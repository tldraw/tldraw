{
	"$schema": "https://turborepo.com/schema.json",
	"envMode": "loose",
	"ui": "stream",
	"globalDependencies": [
		"internal/config/**",
		"internal/scripts/**",
		"!internal/**/*.tsbuildinfo",
		"!internal/**/.tsbuild*/**",
		"!internal/**/.turbo/**",
		"!internal/**/node_modules/**"
	],
	"tasks": {
		"//#refresh-assets": {
			"inputs": [
				"package.json",
				"internal/scripts/refresh-assets.ts",
				"assets/**",
				"apps/dotcom/client/assets/**",
				"packages/*/package.json"
			],
			"outputs": []
		},
		"build-types": {
			"dependsOn": ["^build-types", "//#refresh-assets"],
			"outputs": [".tsbuild/**", "*.tsbuildinfo"]
		},
		"build-api": {
			"dependsOn": ["build-types"],
			"inputs": ["src/**", "tsconfig.json", "api-extractor.json"],
			"outputs": ["api/**", "api-report.api.md"]
		},
		"build-i18n": {
			"outputs": ["public/tla/locales/en.json", "public/tla/locales-compiled/**"]
		},
		"prebuild": {
			"cache": false
		},
		"predev": {
			"cache": false
		},
		"build": {
			"dependsOn": [
				"^build-types",
				"prebuild",
				"^prebuild",
				"build-i18n",
				"^build-i18n",
				"//#refresh-assets"
			],
			"outputs": ["dist/**", "dist-*/**", ".next/**", "!.next/cache/**"]
		},
		"dev": {
			"dependsOn": ["predev", "^predev", "build-i18n", "^build-i18n", "//#refresh-assets"],
			"cache": false,
			"persistent": true
		},
		"check-bundle-size": {
			"outputs": []
		}
	}
}
